<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.AndroidUICompose" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="actionModeBackground">@color/action_mode_blue</item>
        <item name="actionModeStyle">@style/Widget.AndroidUICompose.ActionMode</item>
        <item name="actionModeCloseDrawable">@drawable/ic_arrow_back_white</item>
        <item name="actionMenuTextColor">@color/white</item>
    </style>

    <style name="Theme.AndroidUICompose" parent="Base.Theme.AndroidUICompose" />

    <style name="TextAppearance.AndroidUICompose.ActionMode.Title"
        parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.AndroidUICompose.ActionMode"
        parent="Widget.AppCompat.ActionMode">
        <item name="titleTextStyle">@style/TextAppearance.AndroidUICompose.ActionMode.Title</item>
        <item name="subtitleTextStyle">@style/TextAppearance.AndroidUICompose.ActionMode.Title</item>
    </style>
</resources>
